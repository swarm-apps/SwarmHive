{
  "name": "@swarm-hive/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "openapi": "cargo run -p swarmhive-server --bin dump-openapi --quiet > /tmp/swarmhive-openapi.json && openapi-typescript /tmp/swarmhive-openapi.json -o src/lib/api/schema.gen.ts && biome check --write src/lib/api/schema.gen.ts",
    "openapi:live": "openapi-typescript http://localhost:3030/api/openapi.json -o src/lib/api/schema.gen.ts && biome check --write src/lib/api/schema.gen.ts",
    "bundle:analyze": "cross-env BUNDLE_ANALYZE=1 vite build"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.2.3",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.12-0",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-router": "^1.167.0",
    "antd": "^6.4.3",
    "comlink": "^4.4.2",
    "dayjs": "^1.11.13",
    "hash-wasm": "^4.12.0",
    "openapi-fetch": "^0.17",
    "openapi-react-query": "^0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@lingui/cli": "^6.0.0",
    "@lingui/format-po": "^6.0.0",
    "@lingui/swc-plugin": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@playwright/test": "^1.50.0",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.167.0",
    "@testcontainers/postgresql": "^11",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/ui": "^3.0.0",
    "cross-env": "^10.0.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7",
    "rollup-plugin-visualizer": "^5.12.0",
    "testcontainers": "^10.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.12",
    "vitest": "^3.0.0"
  }
}
