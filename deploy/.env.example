# deploy/docker-compose.yml 的环境变量。复制为 deploy/.env 后改成强随机值。
# 带 `:?` 的变量在 compose 里是**必填**(不设直接报错),其余有默认值。

# ── Postgres ──
SWARMHIVE_PG_USER=swarmhive
SWARMHIVE_PG_PASSWORD=change-me-strong-db-password
SWARMHIVE_PG_DB=swarmhive

# ── RustFS(S3 兼容存储)──
# 生产务必用强随机值,如 `openssl rand -hex 24`,否则任何人可读写你的对象存储。
SWARMHIVE_RUSTFS_ACCESS_KEY=change-me-strong-access-key
SWARMHIVE_RUSTFS_SECRET_KEY=change-me-strong-secret-key
SWARMHIVE_RUSTFS_BUCKET=swarmhive

# ── server ──
# AES-256-GCM 对称密钥(base64 的 32 字节):`openssl rand -base64 32`。
# 固定不变 —— 换密钥会导致已加密的邮件 provider 密码无法解密。
SWARMHIVE_SECRET_KEY=

# admin / 邮件链接用的对外 URL(生产必设,前面套了反代就填 https 域名)。
SWARMHIVE_SERVER__BASE_URL=https://updates.example.com

# 可选:把首启 Owner 邮箱钉死,只接受这个邮箱认领 Owner(公开部署推荐)。
SWARMHIVE_BOOTSTRAP_OWNER_EMAIL=
